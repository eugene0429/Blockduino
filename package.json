{
  "name": "blockduino",
  "version": "0.1.0",
  "description": "Block-based Arduino coding app for elementary and middle school students (English / Korean)",
  "repository": "github:eugene0429/Blockduino",
  "keywords": ["arduino", "blockly", "education", "electron", "block-coding"],
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "prepare-arduino": "node scripts/prepare-arduino.mjs",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "blockly": "^11.2.0"
  },
  "build": {
    "appId": "kr.blockduino.app",
    "productName": "Blockduino",
    "files": ["src/**/*", "package.json"],
    "extraResources": [
      { "from": "vendor/arduino/win32", "to": "arduino" }
    ],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["en_US", "ko_KR"]
    }
  }
}
